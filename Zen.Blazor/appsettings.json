{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.Antiforgery": "None",
      "Zen.Blazor.Beacons": "Information"
    }
  },
  "AllowedHosts": "*",
  "Beacons": {
    "MaxBodyBytes": 32768,
    "MemoryBytes": 4194304,
    "MemoryEntries": 2000,
    "StorageBudgetBytes": 50331648,
    "DatabaseLimitBytes": 167772160,
    "RetentionDays": 30,
    "PruneInterval": "00:02:00",
    "WriteBatchSize": 50,
    "MaxPoolSize": 2,
    "WritesPerMinute": 30,
    "ReadsPerMinute": 120,
    "CspKey": "zen-csp"
  }
}
